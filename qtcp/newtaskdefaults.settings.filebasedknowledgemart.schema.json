{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "newtaskdefaults.settings.filebasedknowledgemart.schema.json",
  "title": "Defaults for new File Based Knowledge Mart Task",
  "description": "Schema for File Based Knowledge Mart task default configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskRuntime": {
      "type": "object",
      "description": "Runtime configuration for the task",
      "additionalProperties": false,
      "properties": {
         "warehouseSelection": {
          "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/warehouseSelection"
