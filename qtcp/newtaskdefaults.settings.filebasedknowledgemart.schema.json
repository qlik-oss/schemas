    "vectorDbTargetType": {
      "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/vectorDbTargetType"
    },
    "vectorDbConnection": {
      "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/vectorDbConnection"
    },
    "llmConnection": {
      "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/llmConnection"
    },
    "llmSettings": {
      "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/llmSettings"
