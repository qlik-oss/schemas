{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "newtaskdefaults.settings.streaminglanding.schema.json",
  "title": "Defaults for new Streaming Landing Task",
  "description": "Schema for streaming landing task default configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskRuntime": {
      "type": "object",
      "description": "Runtime configuration for the task",
      "additionalProperties": false,
      "properties": {
        "numberOfReadersTaskSettings": {
					"type": "object",
					"description": "Number of readers settings",
					"additionalProperties": false,
					"properties": {					
						"numberOfReaders": {
							"type": "integer",
							"description": "Number of readers",
							"minimum": 1,
							"default": 1,
							"maximum": 1000
						},
						"numberOfReadersType": {
							"type": "string",
							"description": "Number of readers type",
							"enum": ["AUTOMATIC"],
							"default": "AUTOMATIC"
						}
					}
				}
      }
    },
		"folderRetentionSettings": {
      "type": "object",
      "description": "Folder retention configuration",
      "additionalProperties": false,
      "properties": {
				"type": {
					"type": "string",
					"description": "Retention type",
					"enum": ["NONE", "DELETE", "RETENTION"],
					"default": "NONE"
				},
        "daysOfRetention": {
          "type": "integer",
          "description": "Number of retention days"
        }
      }
    },
    "folderLocationType": {
      "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/folderLocationType"
    },
    "specificFolder": {
      "$ref": "newtaskdefaults.settings.common.schema.json#/definitions/specificFolder"
    }
  }
}
