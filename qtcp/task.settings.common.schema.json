        "beforeCachedChanges": {
          "type": "boolean",
          "description": "Stop before cached changes",
          "enum": [true, false],
          "default": false
        },
        "afterCachedChanges": {
          "type": "boolean",
          "description": "Stop after cached changes",
          "enum": [true, false],
          "default": false
        }
      }
    },
