{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/qlik-oss/schemas/refs/heads/main/qtcp/task.settings.storage.schema.json",
  "title": "Storage Task Settings",
  "description": "Schema for Storage task settings configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactsLocation", "taskRuntime"],
  "properties": {
		"fullLoadOnly": {
			"$ref": "task.settings.common.schema.json#/definitions/fullLoadOnly-False"
    },
    "ddlHandlingPolicy": {
			"$ref": "task.settings.common.schema.json#/definitions/ddlHandlingPolicy"
    },
    "artifactsSettings": {
		  "type": "object",
			"description": "Artifacts settings configuration",
			"additionalProperties": false,
			"properties": {
				"liveViewsEnabled": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsLiveViewsEnabled" },
				"historyEnabled": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsHistoryEnabled" },
				"materialized": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsMaterialized" },
				"changeTablesEnabled": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsChangeTablesEnabled" },
				"currentTableSuffix": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsCurrentTableSuffix" },
				"reloadType": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsReloadType-Standard" },
				"createConsumptionViews": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsCreateConsumptionViews" },
				"artifactsPrefix": { "$ref": "task.settings.common.schema.json#/definitions/artifactsSettingsArtifactsPrefix" }
			}
    },
    "artifactsLocation": {
			"$ref": "task.settings.common.schema.json#/definitions/artifactsLocationWithDatabase"
    },
    "taskRuntime": {
      "type": "object",
      "description": "Task runtime configuration",
      "additionalProperties": false,
      "required": ["warehouseSelection"],
      "properties": {
        "tableUpdateConcurrency": {
          "$ref": "task.settings.common.schema.json#/definitions/tableUpdateConcurrency"
        },
        "warehouseSelection": {
          "$ref": "task.settings.common.schema.json#/definitions/warehouseSelection"
        }
      }
    },
    "catalogIntegration": {
			"$ref": "task.settings.common.schema.json#/definitions/catalogIntegration"
    },
    "tableTypeSettings": {
			"$ref": "task.settings.common.schema.json#/definitions/tableTypeSettings"
    },
    "viewType": {
      "$ref": "task.settings.common.schema.json#/definitions/viewType"
    }
  }
}
