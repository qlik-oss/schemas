{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/qlik-oss/schemas/refs/heads/main/qtcp/task.settings.transform.schema.json",
	"title": "Transform Task Settings",
	"description": "Schema for Transform task settings configuration",
	"type": "object",
	"additionalProperties": false,
	"required": ["artifactsLocation", "taskRuntime"],
	"properties": {
		"fullLoadOnly": {
			"$ref": "task.settings.common.schema.json#/definitions/fullLoadOnly-True"
		},
		"artifactsSettings": {
			"$ref": "task.settings.common.schema.json#/definitions/artifactsSettings-WithDeletedRows"
    },
		"artifactsLocation": {
			"$ref": "task.settings.common.schema.json#/definitions/artifactsLocationWithDatabase"
    },
		"taskRuntime": {
      "type": "object",
      "description": "Task runtime configuration",
      "additionalProperties": false,
      "required": ["warehouseSelection"],
      "properties": {
        "tableUpdateConcurrency": {
          "$ref": "task.settings.common.schema.json#/definitions/tableUpdateConcurrency"
        },
        "warehouseSelection": {
          "$ref": "task.settings.common.schema.json#/definitions/warehouseSelection"
        }
      }
    },
		"catalogIntegration": {
			"$ref": "task.settings.common.schema.json#/definitions/catalogIntegration"
    },
		"tableTypeSettings": {
			"$ref": "task.settings.common.schema.json#/definitions/tableTypeSettings"
    },
		"viewType": {
      "$ref": "task.settings.common.schema.json#/definitions/viewType"
    }
	}
}