{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "task.transformationdataflow.schema.json",
	"title": "Task transformation data flow Configuration",
	"description": "Schema for task transformation data flow configuration",
	"type": "object",
	"properties": {
		"name": {
			"type": "string",
			"description": "Transformation flow name",
			"examples": ["myflow1"]
		},
		"description": {
			"type": "string",
			"description": "Transformation flow description"
		},
		"modelVersion": {
			"type": "string",
			"description": "Model version"
		},
		"context": {
			"type": "object",
			"description": "Model context",
			"properties": {
				"projectId": {
					"type": "string",
					"description": "Project identifier",
					"examples": ["{{ref(project.current.projectId)}}"]
				},
				"dataAppId": {
					"type": "string",
					"description": "source task",
					"examples": ["transform_flow_3-iqus"]
				}
			},
			"required": [],
			"additionalProperties": false
		},
		"graph": {
			"type": "string",
			"description": "graph data, json format"
		}
	},
	"required": [],
	"additionalProperties": false
}
